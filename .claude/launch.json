{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "beolkkuri-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["ui/dev/dev_server.py"],
      "port": 8765
    },
    {
      "name": "beolkkuri-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "ui", "dev"],
      "port": 5173
    },
    {
      "name": "beolkkuri-site",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8790", "--directory", "site"],
      "port": 8790
    }
  ]
}
